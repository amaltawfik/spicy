# Transient R plot device output (when Rscript runs plotting code
# without an explicit pdf()/png() device).
Rplots.pdf

# testthat scratch (auto-regenerated per run)
tests/testthat/_problems/
tests/testthat/testthat-problems.rds
# A failing snapshot writes <name>.new.md next to the reference and
# leaves it there unless snapshot_accept() (or the next green run)
# removes it. `git add -A` then commits the failure as if it were the
# reference -- twice during the i18n campaign. The accepted snapshot
# is <name>.md; the .new.md is never an artifact worth versioning.
# `**` also matches zero directories, so this covers both the flat
# files and the `_snaps/<variant>/` subdirectories testthat creates for
# `expect_snapshot(variant = )` and `expect_snapshot_file()`.
tests/testthat/_snaps/**/*.new.md
# Session-generated working notes (specs, findings, drafts) stay
# local; the tracked dev/ scripts and design docs remain versioned.
dev/*_spec.md
dev/*_plan.md
dev/*_finding.md
dev/*_findings.md
dev/*_alignment.md
dev/*_draft.md
dev/*_TO_PASTE.md
dev/*_retriage.md
dev/*.pdf
dev/*.epub
dev/_source/
# Journal style guides (copyrighted PDFs; catalogued in
# dev/journal_styles_sources.md, which stays versioned).
dev/journal_styles/
/*.tar.gz
tools/suite_results.csv

# Stan fixture cache: brmsfit / stanreg objects sampled once and read
# back by the test helpers (tests/testthat/helper-stan-cache.R). Large,
# machine-specific, and regenerated on demand.
dev/.fixture_cache/
